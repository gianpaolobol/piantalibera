{
  "expo": {
    "name": "Pianta Libera",
    "slug": "pianta-libera",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#e9ece8",
    "scheme": "piantalibera",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#e9ece8"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.piantalibera.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Pianta Libera usa la fotocamera quando scatti la foto di una stanza per «Da foto al 3D» e durante la «Scansione AR» della stanza.",
        "NSPhotoLibraryUsageDescription": "Pianta Libera apre le foto che scegli per «Da foto al 3D» e per i materiali."
      }
    },
    "android": {
      "package": "it.piantalibera.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F6F62"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "site": "https://pianta-libera.gianpaolo-franceschini.workers.dev/"
    }
  }
}
